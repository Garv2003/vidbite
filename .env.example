# Copy to .env and fill in. Never commit real secrets.

# --- server ---
# Signing key for JWT access/refresh tokens. Use a long random string in prod.
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Google Gemini API key (used for video summarization).
GOOGLE_API_KEY=your-gemini-api-key
# SQLAlchemy database URL. docker-compose sets this to Postgres automatically;
# for local dev without compose, defaults to sqlite:///data.db.
# DATABASE_URL=postgresql://vidbite:vidbite@localhost:5432/vidbite
# Port the API binds to (hosts like Render/Fly inject their own $PORT).
PORT=8907

# --- database (docker-compose) ---
POSTGRES_PASSWORD=vidbite

# --- client (build-time; Vite inlines it) ---
# Base URL of the API the client calls, e.g. http://localhost:8907 locally
# or https://vidbite-api.onrender.com in production.
VITE_API_URL=http://localhost:8907
